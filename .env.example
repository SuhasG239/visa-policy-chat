# Copy to .env and adjust. Never commit .env.

# LLM: Claude via the Anthropic API. Questions are sent to Anthropic.
ANTHROPIC_API_KEY=
# Development uses Sonnet; production target is claude-opus-5-5.
LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Local token-count log (no conversation content). Leave empty to turn off.
LLM_USAGE_LOG=data/usage.jsonl

# Embeddings. Changing this requires a full re-index.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Instruction prepended to queries (not documents). BGE v1.5 English models use this one.
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Vector store
DB_DIR=db
DB_COLLECTION=visa_policy
